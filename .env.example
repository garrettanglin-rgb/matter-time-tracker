# Copy this file to .env and fill in your values.

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Path to matters registry JSON (optional, defaults to ./matters_registry.json)
# MATTERS_REGISTRY_PATH=/absolute/path/to/matters_registry.json

# Directory for exported reports (optional, defaults to ./output)
# OUTPUT_DIR=/absolute/path/to/output
